# Server-only. Copy to .env locally; never commit real secrets.
HOST=127.0.0.1
PORT=4318
PUBLIC_ORIGIN=http://127.0.0.1:4318
ALLOWED_ORIGINS=http://127.0.0.1:4317,http://localhost,capacitor://localhost,rankwisp://app
DB_PATH=.data/rankwisp.sqlite
NODE_ENV=development
# Local Node fallback only. Cloudflare uses Google OIDC; see worker/wrangler.jsonc.
# Node production fallback requires a strong invitation code, legal review and TLS.
INVITE_CODE=
LEGAL_APPROVED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_DECISION_MODEL=gpt-6.1-sol
AI_GLOBAL_BUDGET_USD=20
# Conservative per-request reservation; bounds total spend independently of tokens.
AI_STANDARD_RESERVATION_USD=0.02
AI_DECISION_RESERVATION_USD=0.12
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
APPLE_BUNDLE_ID=ch.zhstudio.rankwisp
APPLE_APP_ID=
APPLE_PRODUCT_ID=ch.zhstudio.rankwisp.lifetime
APPLE_TRIAL_PRODUCT_ID=ch.zhstudio.rankwisp.trial24
APPLE_ENVIRONMENT=Sandbox
APPLE_ROOT_CERTS_DIR=
# Optional build-time API origin, must be HTTPS for distributed native apps.
VITE_API_ORIGIN=
# For build:native use NATIVE_API_ORIGIN=https://rank.zhstudio.ch
SITE_URL=
