{
  "name": "rankwisp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A clearer view of your app's next move.",
  "main": "desktop/main.cjs",
  "author": {
    "name": "Yannis Ress Lasser",
    "email": "yan.6678.yan@gmail.com"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build && node scripts/prerender.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "pack:mac": "electron-builder --mac dir --arm64",
    "pack:win": "electron-builder --win zip --x64",
    "ios:sync": "cap sync ios",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^2.0.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "d3-shape": "^3.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "ch.zhstudio.rankwisp",
    "productName": "Rankwisp",
    "directories": {
      "output": "../releases"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "public/icon.png",
      "identity": null
    },
    "win": {
      "icon": "public/icon.png",
      "target": "zip",
      "signAndEditExecutable": false
    },
    "asar": true
  }
}
