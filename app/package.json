{
  "name": "rankwisp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A clearer view of your app's next move.",
  "main": "desktop/main.cjs",
  "author": {
    "name": "Yannis Ress Lasser",
    "email": "yan.6678.yan@gmail.com"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build && node scripts/prerender.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "pack:mac": "electron-builder --mac dir --arm64",
    "pack:win": "electron-builder --win zip --x64",
    "ios:sync": "cap sync ios",
    "test:browser": "playwright test",
    "build:pages": "npm run build",
    "build:native": "node scripts/build-native.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --env local",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc --env=\"\"",
    "worker:preview": "wrangler deploy --config worker/wrangler.jsonc --env preview",
    "test:worker": "vitest run --config worker/vitest.config.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^2.0.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "d3-shape": "^3.2.0",
    "express": "^5.1.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^7.4.0",
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "build": {
    "appId": "ch.zhstudio.rankwisp",
    "productName": "Rankwisp",
    "directories": {
      "output": "../releases"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "public/icon.png",
      "identity": null
    },
    "win": {
      "icon": "public/icon.png",
      "target": "zip",
      "signExecutable": false
    },
    "asar": true,
    "protocols": [
      {
        "name": "Rankwisp sign-in",
        "schemes": [
          "rankwisp"
        ]
      }
    ]
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
